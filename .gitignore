tools/bin/

.DS_Store
.DS_Store
.DS_Store
.DS_Store
# Logs and tmp
*.log
tmp/
.tmp/

# Project-local data (re-include if you actually want to ship samples)
data/

# Operator scratch (never committed)
/.local/
prototypes/

# Claude Code operator-local settings (per-operator, never committed). Reconciled
# against the tracked floor .claude/settings-template.json by bin/reconcile-settings.py,
# which creates the file by hand — so this line, not Claude Code's global exclude,
# keeps it out of git. This repo never tracks a .claude/settings.json.
.claude/settings.local.json

# Claude Code worktrees (`claude --worktree`, subagent isolation) — inside a session's scope,
# never committed (spec sibling-access-practice)
.claude/worktrees/
